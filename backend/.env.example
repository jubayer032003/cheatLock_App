# CheatLock backend environment template.
# Copy to backend/.env for local backend development.
# Do not commit populated .env files.

# Required: MongoDB connection for the backend.
MONGODB_URI=mongodb://localhost:27017/cheatlock

# Required: long random JWT signing secret. Replace before running.
JWT_SECRET=replace-with-a-long-random-value

# Optional: token lifetime. Production default is 1h when omitted.
JWT_EXPIRES_IN=7d

# Optional: structured log level. Use DEBUG only for local diagnostics.
LOG_LEVEL=INFO

# Optional: backend port.
PORT=3000

# Required in production: comma-separated browser origins allowed by CORS.
# Do not use "*"; production startup rejects missing, wildcard, or malformed origins.
# Native clients and server-side checks may send no Origin header; exact browser origins are still required.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLIENT_ORIGIN=http://localhost:5173

# Optional: password-reset token lifetime in minutes.
RESET_TOKEN_EXPIRES_MINUTES=30

# Optional: auth-sensitive rate-limit tuning is controlled in backend code by group.
# Current groups: login, signup, password reset, access-code, socket auth, general API.

# Optional: database name override.
MONGODB_DB_NAME=cheatlock

# Optional: Redis rate limiter URL. Local-only default is used when omitted.
REDIS_URL=redis://127.0.0.1:6379

# Optional as a complete group: telemetry object storage.
# Leave all S3_* values blank to disable S3 storage in local development.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Optional as a complete group: Central Question Bank and Self Exam storage.
# These values are used only by the backend. Never expose SUPABASE_SERVICE_ROLE_KEY
# to Android, browser, desktop, or other client builds.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Health endpoints:
# GET /health/live checks only process liveness.
# GET /health/ready checks required configuration and MongoDB readiness.
