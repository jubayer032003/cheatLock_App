VITE_API_BASE_URL=http://localhost:3000

# Disabled by default. Enable only for local development when testing live proctoring events.
VITE_ENABLE_PROCTORING_TEST_TOOLS=false

# Experimental hardcoded model/analytics catalog. Keep hidden in production V1.
VITE_ENABLE_MODEL_DATA_PAGE=false

# Read-only placeholder page; keep hidden until real teacher preferences exist.
VITE_ENABLE_SETTINGS_PAGE=false
