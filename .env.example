# CheatLock local environment template.
# Copy to .env or backend/.env for local development. Never commit real values.

# Required backend settings.
MONGODB_URI=mongodb://localhost:27017/cheatlock
JWT_SECRET=replace-with-a-long-random-value

# Optional backend settings.
JWT_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_MINUTES=30
LOG_LEVEL=INFO
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLIENT_ORIGIN=http://localhost:5173
MONGODB_DB_NAME=cheatlock
REDIS_URL=redis://127.0.0.1:6379

# Docker Compose local MinIO credentials.
# Required only when running the bundled MinIO service.
MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password

# Optional S3/MinIO telemetry storage.
# For Docker Compose local development, set endpoint to the MinIO service URL.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=replace-with-local-bucket-name
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
S3_REGION=us-east-1

# Optional dashboard setting.
VITE_API_BASE_URL=http://localhost:3000
VITE_ENABLE_PROCTORING_TEST_TOOLS=false

# Optional desktop settings.
VITE_CHEATLOCK_API_ORIGIN=http://127.0.0.1:3000
VITE_CHEATLOCK_WS_ORIGIN=ws://127.0.0.1:3000
VITE_CHEATLOCK_ENABLE_LIVENESS_BYPASS=false
VITE_CHEATLOCK_ENABLE_MONITORING_SIMULATION=false
